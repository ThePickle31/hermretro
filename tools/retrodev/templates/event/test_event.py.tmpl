"""The {full} event of backend/{name}.

Run alone: python -m unittest tests.backend.{name}.test_event_{event}
"""

import sys
import unittest
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))

import backend.{name} as feature  # noqa: E402 - the repository root goes on sys.path first
from backend.{name} import emits  # noqa: E402 - the repository root goes on sys.path first
from backend.system import events  # noqa: E402 - the repository root goes on sys.path first
from tests.support import isolated_home  # noqa: E402 - the repository root goes on sys.path first


class Event{Event}(unittest.TestCase):
    def setUp(self):
        # The real emitter reaches every feature's listeners (rule 7 in AGENTS.md): they write only here.
        isolated_home(self)

    def test_it_is_declared_and_reaches_a_listener(self):
        self.assertIn("{full}", feature.EVENTS)
        heard = []
        listener = events.on("{full}")(lambda **payload: heard.append(payload))
        self.addCleanup(events._listeners["{full}"].remove, listener)
        emits.{event}({sample})
        self.assertEqual(heard, [{heard}])


if __name__ == "__main__":
    unittest.main()
