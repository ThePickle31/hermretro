

@rpc("{rpc}")
def rpc_{rpc}(ctx):
    """The page's ``{rpc}`` RPC (docs/dev/CONTRACT.md): ``{{ game }}`` -> ``{{ ok, game }}``; a game that is not in
    the library answers NO_GAME. Never raises."""

    def {rpc}(params, **_kwargs):
        try:
            params = params if isinstance(params, dict) else {}
            game = str(params.get("game") or "")
            root = host._game_root(game)
            if root is None:
                return {"ok": False, "code": "NO_GAME", "error": "Only a game in your library can be used here."}
            return {"ok": True, "game": game}
        except Exception as error:  # an RPC answers {ok: false} instead of raising
            logger.exception("hermretro {rpc} failed")
            return {"ok": False, "code": "ERROR", "error": f"{type(error).__name__}: {error}"}

    return {rpc}
