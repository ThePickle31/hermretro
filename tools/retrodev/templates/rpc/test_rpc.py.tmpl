"""The {rpc} RPC of backend/{name}.

Run alone: python -m unittest tests.backend.{name}.test_rpc_{rpc}

isolated_home(self) (tests/support.py) points HERMRETRO_HOME and the plugin's data folder at a temp folder: never
the real library.
"""

import sys
import unittest
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3]))

from backend.{name} import rpcs  # noqa: E402 - the repository root goes on sys.path first
from tests.support import isolated_home  # noqa: E402 - the repository root goes on sys.path first


class Rpc{Rpc}(unittest.TestCase):
    def setUp(self):
        isolated_home(self)
        self.handler = rpcs.rpc_{rpc}(None)

    def test_it_answers_ok(self):
        self.assertEqual(self.handler({{"echo": "hi"}}), {{"ok": True, "echo": "hi"}})

    def test_any_params_get_an_answer_never_an_exception(self):
        for params in (None, "text", [], {{}}):
            self.assertIn("ok", self.handler(params))


if __name__ == "__main__":
    unittest.main()
