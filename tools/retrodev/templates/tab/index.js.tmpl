// The {Label} tab of the {page} page: its descriptor ({{ id, label, Page }}, as a page has; app/registry.js).
import { jsx, jsxs } from '#sdk'
import { Heading, Lede } from '#shared/ui/text.js'

function {Component}() {
  return jsxs('div', { className: 'cs-col', children: [jsx(Heading, { children: '{Label}' }), jsx(Lede, { children: '{Label}: describe what this tab shows.' })] })
}

export const {CONST}_TAB = {
  id: '{tab}',
  label: '{Label}',
  Page: {Component}
}
