

{TOOL}_TOOL = {
    "name": "{tool}",
    "description": "Describe what {tool} does and when the agent should call it.",
    "parameters": {"type": "object", "properties": {}, "additionalProperties": False},
}


def {short}_handler(args, **_kwargs) -> str:
    """{tool}: answers a JSON string, never raises."""
    try:
        args = args if isinstance(args, dict) else {}
        return json.dumps({"ok": True, "args": sorted(args)})
    except Exception as error:  # a handler must never raise
        logger.exception("{tool} failed")
        return json.dumps({"ok": False, "error": f"{type(error).__name__}: {error}", "code": "ADAPTER_ERROR"})
